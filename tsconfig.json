{
	"compilerOptions": {
		"rootDir": "./",
		"outDir": "./dist",
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"lib": ["DOM", "es2017"],
		// 检查未使用的局部变量
		"noUnusedLocals": true,
		// 检查未使用的函数参数
		"noUnusedParameters": true
	},
	"include": ["javascript_libs/**/*", "products/**/*", "github_repositories/learning/pixijs/**/*"]
}
